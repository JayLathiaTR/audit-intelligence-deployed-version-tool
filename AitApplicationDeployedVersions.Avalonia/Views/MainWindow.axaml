<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AitApplicationDeployedVersions.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AitApplicationDeployedVersions.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/aitversion-logo.ico"
    Title="Audit Intelligence Suite - Deployed Versions"
    Width="1100" Height="700"
    MinWidth="900" MinHeight="600"
    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <Window.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Margin="24">
        <StackPanel Spacing="4">
            <TextBlock Text="Audit Intelligence Suite - Deployed Versions" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Select an environment and fetch deployed versions." Opacity="0.75" />
        </StackPanel>

        <Border Grid.Row="1"
            Padding="14"
            CornerRadius="12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <TextBlock Text="Environment" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Width="200"
                          ItemsSource="{Binding Environments}"
                          SelectedItem="{Binding SelectedEnvironment}" />

            <Button Grid.Column="2"
                        Classes="accent"
                Content="Fetch AIT"
                        IsDefault="True"
                Command="{Binding FetchAitCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            <Button Grid.Column="3"
                Classes="accent"
                Content="Fetch AIA"
                Command="{Binding FetchAiaCommand}"
                IsEnabled="{Binding IsNotBusy}" />

            <TextBlock Grid.Row="1" Grid.ColumnSpan="5"
                           Text="{Binding StatusText}"
                           FontSize="14"
                           Opacity="0.85"
                           TextWrapping="Wrap" />

            <ProgressBar Grid.Row="2" Grid.ColumnSpan="5"
                             Minimum="0" Maximum="100"
                             Height="8"
                             Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Deployed Versions">
                <Grid RowDefinitions="*,*" RowSpacing="14">
                    <Border
                        Padding="10"
                        CornerRadius="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Text="{Binding AitHeaderText}" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ResultsAit}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding App}" Width="2*" />
                                    <DataGridTextColumn Header="Deployed Version" Binding="{Binding DeployedVersion}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                        Padding="10"
                        CornerRadius="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Text="{Binding AiaHeaderText}" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ResultsAia}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding App}" Width="2*" />
                                    <DataGridTextColumn Header="Deployed Version" Binding="{Binding DeployedVersion}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
