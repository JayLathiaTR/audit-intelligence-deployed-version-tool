<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AitApplicationDeployedVersions.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AitApplicationDeployedVersions.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/aitversion-logo.ico"
    Title="Audit Intelligence Suite - Deployed Versions"
    Width="1100" Height="700"
    MinWidth="900" MinHeight="600"
    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <Window.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14" Margin="24">
        <StackPanel Spacing="4">
            <TextBlock Text="Audit Intelligence Suite - Deployed Versions" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Select an environment and fetch deployed versions." Opacity="0.75" />
        </StackPanel>

        <Border Grid.Row="1"
            Padding="14"
            CornerRadius="12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <TextBlock Text="Environment" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          Width="200"
                          ItemsSource="{Binding Environments}"
                          SelectedItem="{Binding SelectedEnvironment}" />

            <Button Grid.Column="2"
                        Classes="accent"
                Content="Fetch AIT"
                        IsDefault="True"
                Command="{Binding FetchAitCommand}"
                        IsEnabled="{Binding IsNotBusy}" />

            <Button Grid.Column="3"
                Classes="accent"
                Content="Fetch AIA"
                Command="{Binding FetchAiaCommand}"
                IsEnabled="{Binding IsNotBusy}" />

            <TextBlock Grid.Row="1" Grid.ColumnSpan="5"
                           Text="{Binding StatusText}"
                           FontSize="14"
                           Opacity="0.85"
                           TextWrapping="Wrap" />

            <ProgressBar Grid.Row="2" Grid.ColumnSpan="5"
                             Minimum="0" Maximum="100"
                             Height="8"
                             Value="{Binding ProgressValue}"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Deployed Versions">
                <Grid RowDefinitions="*,*" RowSpacing="14">
                    <Border
                        Padding="10"
                        CornerRadius="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Text="AIT (Test)" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ResultsAit}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding App}" Width="2*" />
                                    <DataGridTextColumn Header="Deployed Version" Binding="{Binding DeployedVersion}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                        Padding="10"
                        CornerRadius="12"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Text="AIA (Analyze)" FontWeight="SemiBold" />
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ResultsAia}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="None"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="App" Binding="{Binding App}" Width="2*" />
                                    <DataGridTextColumn Header="Deployed Version" Binding="{Binding DeployedVersion}" Width="3*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Work Items">
                <Grid RowDefinitions="Auto,*" RowSpacing="14">
                    <TextBlock Text="Work items are tracked per set (AIT/AIA)." Opacity="0.75" TextWrapping="Wrap" />

                    <TabControl Grid.Row="1">
                        <TabItem Header="AIT (Test)">
                            <Grid RowDefinitions="Auto,*,*" RowSpacing="14">
                                <TextBlock Text="{Binding WorkItemsStatusTextAit}" Opacity="0.85" TextWrapping="Wrap" />
                                <ProgressBar Grid.Row="0"
                                             Margin="0,28,0,0"
                                             Minimum="0" Maximum="100"
                                             Height="6"
                                             Value="{Binding WorkItemsProgressAit}"
                                             IsVisible="{Binding WorkItemsIsBusyAit}" />
                                <Border
                                    Grid.Row="1"
                                    Padding="10"
                                    CornerRadius="12"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8" ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="Linked Work Items (from PR description AB#...)" FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Content="Open selected PR"
                                                Command="{Binding OpenSelectedLinkedPullRequestAitCommand}" />
                                        <Button Grid.Column="2"
                                                Content="Open selected Work Item"
                                                Command="{Binding OpenSelectedLinkedWorkItemAitCommand}" />
                                        <DataGrid Grid.Row="1" Grid.ColumnSpan="3"
                                                  ItemsSource="{Binding LinkedWorkItemsAit}"
                                                  SelectedItem="{Binding SelectedLinkedWorkItemAit}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="None"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Service" Binding="{Binding App}" Width="2*" />
                                                <DataGridTextColumn Header="Work Item" Binding="{Binding WorkItemId}" Width="1*" />
                                                <DataGridTextColumn Header="PR" Binding="{Binding PullRequestNumber}" Width="1*" />
                                                <DataGridTextColumn Header="PR Title" Binding="{Binding PullRequestTitle}" Width="4*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                    Padding="10"
                                    CornerRadius="12"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="PRs with no AB# work items" FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Content="Open selected PR"
                                                Command="{Binding OpenSelectedUnlinkedPullRequestAitCommand}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="These PRs didn't have a valid AB#123456 in the description." Opacity="0.7" />
                                        <DataGrid Grid.Row="2" Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding UnlinkedPullRequestsAit}"
                                                  SelectedItem="{Binding SelectedUnlinkedPullRequestAit}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="None"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Service" Binding="{Binding App}" Width="2*" />
                                                <DataGridTextColumn Header="PR" Binding="{Binding PullRequestNumber}" Width="1*" />
                                                <DataGridTextColumn Header="PR Title" Binding="{Binding PullRequestTitle}" Width="5*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="AIA (Analyze)">
                            <Grid RowDefinitions="Auto,*,*" RowSpacing="14">
                                <TextBlock Text="{Binding WorkItemsStatusTextAia}" Opacity="0.85" TextWrapping="Wrap" />
                                <ProgressBar Grid.Row="0"
                                             Margin="0,28,0,0"
                                             Minimum="0" Maximum="100"
                                             Height="6"
                                             Value="{Binding WorkItemsProgressAia}"
                                             IsVisible="{Binding WorkItemsIsBusyAia}" />
                                <Border
                                    Grid.Row="1"
                                    Padding="10"
                                    CornerRadius="12"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                    <Grid RowDefinitions="Auto,*" RowSpacing="8" ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="Linked Work Items (from PR description AB#...)" FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Content="Open selected PR"
                                                Command="{Binding OpenSelectedLinkedPullRequestAiaCommand}" />
                                        <Button Grid.Column="2"
                                                Content="Open selected Work Item"
                                                Command="{Binding OpenSelectedLinkedWorkItemAiaCommand}" />
                                        <DataGrid Grid.Row="1" Grid.ColumnSpan="3"
                                                  ItemsSource="{Binding LinkedWorkItemsAia}"
                                                  SelectedItem="{Binding SelectedLinkedWorkItemAia}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="None"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Service" Binding="{Binding App}" Width="2*" />
                                                <DataGridTextColumn Header="Work Item" Binding="{Binding WorkItemId}" Width="1*" />
                                                <DataGridTextColumn Header="PR" Binding="{Binding PullRequestNumber}" Width="1*" />
                                                <DataGridTextColumn Header="PR Title" Binding="{Binding PullRequestTitle}" Width="4*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                    Padding="10"
                                    CornerRadius="12"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1">
                                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="PRs with no AB# work items" FontWeight="SemiBold" />
                                        <Button Grid.Column="1"
                                                Content="Open selected PR"
                                                Command="{Binding OpenSelectedUnlinkedPullRequestAiaCommand}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="These PRs didn't have a valid AB#123456 in the description." Opacity="0.7" />
                                        <DataGrid Grid.Row="2" Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding UnlinkedPullRequestsAia}"
                                                  SelectedItem="{Binding SelectedUnlinkedPullRequestAia}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="None"
                                                  SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Service" Binding="{Binding App}" Width="2*" />
                                                <DataGridTextColumn Header="PR" Binding="{Binding PullRequestNumber}" Width="1*" />
                                                <DataGridTextColumn Header="PR Title" Binding="{Binding PullRequestTitle}" Width="5*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
